// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GET /api/analyze-packages > returns the API description document 1`] = `
{
  "body": {
    "description": "Analyze package dependencies and check for outdated packages across multiple package managers.",
    "documentation": "https://docs.depman.cloud/",
    "endpoints": {
      "GET /api/package/:registry/:name": {
        "description": "Get information for a single package",
        "parameters": {
          "name": "Package name",
          "registry": "npm | pip | pypi | pub | dart | flutter",
        },
        "queryParams": {
          "current": "string (optional) - Current version to compare",
        },
      },
      "POST /api/analyze-packages": {
        "body": {
          "content": "string (required) - Package file content",
          "fileName": "string (optional) - Original filename to help detect package manager",
        },
        "contentType": "application/json",
        "description": "Analyze package file content for outdated dependencies",
        "supportedFormats": [
          "package.json (npm/yarn/pnpm)",
          "requirements.txt (pip)",
          "pubspec.yaml (Dart/Flutter)",
        ],
      },
      "POST /api/mcp": {
        "description": "Model Context Protocol server (Streamable HTTP) for AI agents",
        "tools": [
          "analyze_dependencies",
          "get_package_info",
        ],
      },
    },
    "links": {
      "api": "https://api.depman.cloud",
      "github": "https://github.com/avencadigital/pack-man",
      "website": "https://depman.cloud",
    },
    "name": "Dep-Man — Dependency Manager API",
    "status": "operational",
    "version": "0.3.0",
  },
  "cacheControl": null,
  "contentType": "application/json",
  "status": 200,
}
`;

